{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jja6312.github.io/schemas/oci-cli-blueprint-input.schema.json",
  "title": "NetworkBaseline2TierInput",
  "description": "network-baseline-2tier/v1 사용자 입력 JSON. 폼과 붙여넣기 양방향. v1 은 JSON 만 지원한다. PUBLIC_PRIVATE_STANDARD 는 IGW/NAT/SGW 를 모두 켜고 public/private subnet public IP 정책을 강제하는 고정 preset 이며 독립 toggle 이 아니다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["execution", "naming", "address", "topology"],
  "properties": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "compartmentMode", "compartment"],
      "properties": {
        "profile": { "type": "string", "default": "DEFAULT" },
        "region": { "type": "string", "minLength": 1 },
        "auth": { "type": "string" },
        "compartmentMode": { "enum": ["NAME", "OCID"] },
        "compartment": { "type": "string", "minLength": 1 }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer", "workload", "environment"],
      "properties": {
        "customer": { "type": "string", "minLength": 1 },
        "workload": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["dev", "stg", "prd"] },
        "regionAlias": { "type": "string" },
        "sequence": { "type": "string", "pattern": "^[0-9]{2}$", "default": "01" },
        "overrides": {
          "description": "개별 리소스 이름 override. Manifest 에 override 사실과 이유가 기록된다.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["displayName", "reason"],
            "properties": {
              "displayName": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcnCidrs", "publicSubnetCidr", "privateSubnetCidr"],
      "properties": {
        "vcnCidrs": {
          "description": "v1 은 IPv4 CIDR 정확히 1개.",
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/cidr" }
        },
        "publicSubnetCidr": { "$ref": "#/$defs/cidr" },
        "privateSubnetCidr": { "$ref": "#/$defs/cidr" },
        "sshSourceCidr": {
          "description": "enableSshIngress=true 일 때만 필수. 0.0.0.0/0 은 경고 또는 차단.",
          "$ref": "#/$defs/cidr"
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset"],
      "properties": {
        "preset": { "const": "PUBLIC_PRIVATE_STANDARD" },
        "enableSshIngress": { "type": "boolean", "default": false }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "freeformTags": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "definedTags": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[1-2][0-9]|3[0-2])$"
    }
  }
}
