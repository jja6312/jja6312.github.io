{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jja6312.github.io/schemas/oci-cli-blueprint.schema.json",
  "title": "CliBlueprintDefinition",
  "description": "blog-db blueprint 정의의 구조 계약(설계 10.2~10.11). commandRef/option binding/derived key/pointer 의 카탈로그 대조와 DAG/cycle/semantic 검증은 generate-cli-blueprints.mjs 가 추가로 수행한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "label", "description", "category", "status", "namingPolicyId", "inputs", "presets", "nodes", "rollback", "evidence"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "label": { "type": "string" },
    "description": { "type": "string" },
    "category": { "enum": ["network", "compute", "database", "operations"] },
    "status": { "enum": ["draft", "verified", "deprecated"] },
    "namingPolicyId": { "type": "string" },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/inputDef" } },
    "presets": { "type": "array", "items": { "$ref": "#/$defs/preset" } },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "outputs": { "type": "array", "items": { "type": "object" } },
    "verification": { "type": "array", "items": { "type": "object" } },
    "rollback": { "$ref": "#/$defs/rollbackPolicy" },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "scalarType": { "enum": ["string", "boolean", "number", "stringArray", "json"] },
    "jsonPointer": { "type": "string", "pattern": "^(/[^/]*)*$" },
    "derivedKey": {
      "enum": [
        "normalizedCustomer", "normalizedWorkload", "normalizedEnvironment", "regionAlias",
        "vcnDnsLabel", "publicSubnetDnsLabel", "privateSubnetDnsLabel", "managedFreeformTags",
        "publicRouteRules", "privateRouteRules",
        "publicIngressRules", "publicEgressRules", "privateIngressRules", "privateEgressRules"
      ]
    },
    "valueSource": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["source", "value"], "properties": { "source": { "const": "literal" }, "value": {} } },
        { "type": "object", "additionalProperties": false, "required": ["source", "input"], "properties": { "source": { "const": "input" }, "input": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "key"], "properties": { "source": { "const": "derived" }, "key": { "$ref": "#/$defs/derivedKey" } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "key"], "properties": { "source": { "const": "context" }, "key": { "enum": ["profile", "region", "compartmentId", "tenancyId"] } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "node", "path"], "properties": { "source": { "const": "nodeOutput" }, "node": { "type": "string" }, "path": { "$ref": "#/$defs/jsonPointer" } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "key", "path"], "properties": { "source": { "const": "discovery" }, "key": { "type": "string" }, "path": { "$ref": "#/$defs/jsonPointer" } } },
        { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": { "const": "name" } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "value"], "properties": { "source": { "const": "json" }, "value": {} } }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "input", "operator"],
          "properties": {
            "kind": { "const": "input" },
            "input": { "type": "string" },
            "operator": { "enum": ["equals", "notEquals", "in", "truthy", "falsy"] },
            "value": {}
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["kind", "conditions"], "properties": { "kind": { "enum": ["all", "any"] }, "conditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "condition"], "properties": { "kind": { "const": "not" }, "condition": { "$ref": "#/$defs/condition" } } }
      ]
    },
    "commandRef": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "resource", "operation"], "properties": { "kind": { "const": "resourceOperation" }, "resource": { "type": "string" }, "operation": { "enum": ["get", "list", "create", "delete"] } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "supportCommand" }, "id": { "type": "string" } } }
      ]
    },
    "nodeOutputDef": {
      "type": "object", "additionalProperties": false, "required": ["pointer", "type"],
      "properties": { "pointer": { "$ref": "#/$defs/jsonPointer" }, "type": { "$ref": "#/$defs/scalarType" } }
    },
    "discovery": {
      "type": "object", "additionalProperties": false, "required": ["list", "identity", "onError"],
      "properties": {
        "list": {
          "type": "object", "additionalProperties": false, "required": ["commandRef", "bindings", "pagination", "itemsPointer"],
          "properties": {
            "commandRef": { "$ref": "#/$defs/commandRef" },
            "bindings": { "type": "object", "additionalProperties": { "$ref": "#/$defs/valueSource" } },
            "pagination": { "const": "all" },
            "itemsPointer": { "$ref": "#/$defs/jsonPointer" }
          }
        },
        "identity": {
          "type": "object", "additionalProperties": false, "required": ["idPointer", "namePointer", "expectedName", "cardinality"],
          "properties": {
            "idPointer": { "$ref": "#/$defs/jsonPointer" },
            "namePointer": { "$ref": "#/$defs/jsonPointer" },
            "expectedName": { "$ref": "#/$defs/valueSource" },
            "cardinality": { "const": "zero-or-one" }
          }
        },
        "get": {
          "type": "object", "additionalProperties": false, "required": ["commandRef", "idOption", "collect"],
          "properties": {
            "commandRef": { "$ref": "#/$defs/commandRef" },
            "idOption": { "type": "string" },
            "collect": {
              "type": "object",
              "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["pointer", "type"], "properties": { "pointer": { "$ref": "#/$defs/jsonPointer" }, "type": { "$ref": "#/$defs/scalarType" } } }
            }
          }
        },
        "onError": { "const": "block" }
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false, "required": ["mode", "fields"],
      "properties": {
        "mode": { "const": "exactManagedFields" },
        "fields": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["key", "desired", "actualPointer", "comparator", "required"],
            "properties": {
              "key": { "type": "string" },
              "desired": { "$ref": "#/$defs/valueSource" },
              "actualPointer": { "$ref": "#/$defs/jsonPointer" },
              "comparator": { "enum": ["string", "boolean", "cidrSet", "jsonSet", "ocidSet", "tagSubset"] },
              "required": { "const": true }
            }
          }
        }
      }
    },
    "verifyContract": {
      "type": "object", "additionalProperties": false, "required": ["commandRef", "bindings", "assertions"],
      "properties": {
        "commandRef": { "$ref": "#/$defs/commandRef" },
        "bindings": { "type": "object", "additionalProperties": { "$ref": "#/$defs/valueSource" } },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "actualPointer", "comparator", "expected", "severity"],
            "properties": {
              "id": { "type": "string" },
              "actualPointer": { "$ref": "#/$defs/jsonPointer" },
              "comparator": { "enum": ["equals", "containsSet", "lifecycleAvailable", "tagSubset"] },
              "expected": { "$ref": "#/$defs/valueSource" },
              "severity": { "enum": ["fail", "warn"] }
            }
          }
        }
      }
    },
    "nodeRollback": {
      "type": "object", "additionalProperties": false, "required": ["commandRef", "idOption", "ownership"],
      "properties": {
        "commandRef": {
          "type": "object", "additionalProperties": false, "required": ["kind", "resource", "operation"],
          "properties": { "kind": { "const": "resourceOperation" }, "resource": { "type": "string" }, "operation": { "const": "delete" } }
        },
        "idOption": { "type": "string" },
        "waitForState": { "type": "string" },
        "ownership": {
          "type": "object", "additionalProperties": false, "required": ["requiredActualAction", "runIdTagKey", "requireCurrentTagMatch"],
          "properties": {
            "requiredActualAction": { "const": "CREATED" },
            "runIdTagKey": { "const": "blueprint-run-id" },
            "requireCurrentTagMatch": { "const": true }
          }
        }
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "commandRef", "naming", "dependsOn", "bindings", "discovery", "comparison", "outputs", "verify", "rollback"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "commandRef": {
          "type": "object", "additionalProperties": false, "required": ["resource", "operation"],
          "properties": { "resource": { "type": "string" }, "operation": { "const": "create" } }
        },
        "naming": {
          "type": "object", "additionalProperties": false, "required": ["role"],
          "properties": { "role": { "type": "string" }, "resourceToken": { "type": "string" } }
        },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "when": { "$ref": "#/$defs/condition" },
        "bindings": { "type": "object", "additionalProperties": { "$ref": "#/$defs/valueSource" } },
        "discovery": { "$ref": "#/$defs/discovery" },
        "comparison": { "$ref": "#/$defs/comparison" },
        "outputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nodeOutputDef" } },
        "verify": { "type": "array", "items": { "$ref": "#/$defs/verifyContract" } },
        "rollback": { "$ref": "#/$defs/nodeRollback" }
      }
    },
    "inputDef": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "group", "type"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "group": { "enum": ["execution", "naming", "address", "topology", "metadata"] },
        "type": { "$ref": "#/$defs/scalarType" },
        "required": { "type": "boolean" },
        "requirement": { "enum": ["required", "optional", "conditional"] },
        "default": {},
        "choices": { "type": "array" },
        "help": { "type": "string" }
      }
    },
    "preset": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "values"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "values": { "type": "object" },
        "enforced": { "type": "object" }
      }
    },
    "rollbackPolicy": {
      "type": "object", "additionalProperties": false, "required": ["order"],
      "properties": {
        "order": { "const": "reverseDag" },
        "reusedNodesDeleted": { "const": false },
        "requireConfirm": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["verifiedAt"],
      "properties": {
        "verifiedAt": { "type": "string" },
        "docs": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "url"], "properties": { "label": { "type": "string" }, "url": { "type": "string" } } } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
